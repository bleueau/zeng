  "core_principles": [
    {
      "id": "P01",
      "name": "关系动态决定吸引力",
      "description": "Mikey体系认为，吸引力不来自外在数值（财富、学历、外貌），而来自关系动态中的上位者姿态。女性能感知社交地位高于数值。",
      "source_concepts": ["C004", "C001", "C007", "C013", "C016"],
      "evidence_count": 28
    },
    {
      "id": "P02",
      "name": "潜沟通传递核心信息",
      "description": "Mikey体系认为，表沟通（语言内容）对吸引力的影响远小于潜沟通（状态、气场、行为线索）。女人通过行为线索判断男人价值，而非通过话语。",
      "source_concepts": ["C004", "C007", "C008", "C009", "C014"],
      "evidence_count": 22
    },
    {
      "id": "P03",
      "name": "需求感是吸引力杀手",
      "description": "Mikey体系认为，暴露需求感会让女性感知到已被拿捏，从而停止投入。需求感通过行为线索传递，而非语言。",
      "source_concepts": ["C017", "C002", "C003", "C004", "C007"],
      "evidence_count": 16
    },
    {
      "id": "P04",
      "name": "一致性是长期基础",
      "description": "Mikey体系认为，从开场到收尾、从线上到线下、从约会到长期关系中保持行为一致性，是维持吸引力的必要条件。一致性断裂导致下头。",
      "source_concepts": ["C009", "C002", "C004", "C005", "C007"],
      "evidence_count": 18
    },
    {
      "id": "P05",
      "name": "施压与减压交替",
      "description": "Mikey体系认为，把妹本质是让女生从不舒适到舒适的施压到减压交替过程。施压是为了试探反应和升级关系。但施压过度会失去下一次机会。",
      "source_concepts": ["C001", "C004", "C003"],
      "evidence_count": 21
    },
    {
      "id": "P06",
      "name": "投资差距创造吸引",
      "description": "Mikey体系认为，关系中投资多的一方处于低位。引导对方投资（注意力、情绪、时间）可以巩固吸引。",
      "source_concepts": ["C002", "C001", "C003", "C005"],
      "evidence_count": 12
    },
    {
      "id": "P07",
      "name": "自我价值感独立于外在价值",
      "description": "Mikey体系认为，有客观价值不等于有价值感。价值感是自我认可，不依赖外界反馈。没有价值感的人即使有资源也无法传递吸引力。",
      "source_concepts": ["C002", "C005", "C006"],
      "evidence_count": 19
    },
    {
      "id": "P08",
      "name": "边界感维持框架",
      "description": "Mikey体系认为，清晰表达不适、拒绝不合理要求、不围绕对方转，是维持关系中上位者位置的基本方法。没有边界感会导致被利用。",
      "source_concepts": ["C012", "C005", "C007", "C009"],
      "evidence_count": 8
    },
    {
      "id": "P09",
      "name": "零压力状态最佳",
      "description": "Mikey体系认为，当人不执着于结果、处于放松自然的状态时，反而更容易获得正面结果。过度追求目标会产生压力，导致行为不自然。",
      "source_concepts": ["C001", "C002", "C003", "C006"],
      "evidence_count": 15
    },
    {
      "id": "P10",
      "name": "吸引先于一切技术",
      "description": "Mikey体系认为，没有吸引的情况下任何技术都无效。有吸引时最荒唐的理由也能被接受。技术只能强化吸引，不能创造吸引。",
      "source_concepts": ["C001", "C003", "C004", "C005", "C007", "C008"],
      "evidence_count": 14
    }
  ],

